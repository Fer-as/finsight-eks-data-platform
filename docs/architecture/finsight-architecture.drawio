nnect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="k8s-0"/><mxCell id="k8s-base" value="Components and boundaries" parent="k8s-0"/><mxCell id="k8s-flow1" value="Flow 1  User request" parent="k8s-0"/><mxCell id="k8s-flow3" value="Flow 3  App CI/CD + GitOps" parent="k8s-0"/><mxCell id="k8s-flow6" value="Flow 6  DNS + TLS automation" parent="k8s-0"/><mxCell id="k8s-flow7" value="Flow 7  Metrics scraping" parent="k8s-0"/><mxCell id="k8s-title" value="FinSight on EKS 1.36: namespaces, workloads and in-cluster flows" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="k8s-base"><mxGeometry x="20" y="10" width="1180" height="40" as="geometry"/></mxCell><mxCell id="k8s-origin" value="Native, editable draw.io diagram, originally constructed programmatically from the repository's Terraform and GitOps definitions; edit it in diagrams.net." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;fontStyle=2;align=right;fontColor=#555555;" vertex="1" parent="k8s-base"><mxGeometry x="1210" y="14" width="770" height="34" as="geometry"/></mxCell><mxCell id="k8s-status" value="&lt;b&gt;Deployment status (15 Oct 2026):&lt;/b&gt; the EKS cluster, managed node group and EKS add-ons were previously deployed with Terraform and reached ACTIVE, then destroyed for cost control; node Ready status was not demonstrated with kubectl. Images are published to ECR through the protected dev-images environment (first run 15 Oct, GitOps PR #46). NGINX, cert-manager, ExternalDNS, Argo CD, monitoring, the FinSight workloads and the in-cluster PostgreSQL with its database init Job are implemented in GitOps but &lt;b&gt;not yet deployed&lt;/b&gt;. &lt;i&gt;Planned&lt;/i&gt; (not implemented): the ETL reading S3 raw/ and writing curated/." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4CE;strokeColor=#C9A100;align=left;spacingLeft=10;fontSize=12;fontColor=#3D3000;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="k8s-base"><mxGeometry x="20" y="56" width="1960" height="50" as="geometry"/></mxCell><mxCell id="k8s-nlb" value="Internet-facing NLB (public subnets)&lt;br&gt;created by the AWS Load Balancer Controller" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#333333;container=1;collapsible=0;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="k8s-base"><mxGeometry x="20" y="150" width="220" height="70" as="geometry"/></mxCell><mxCell id="k8s-r53" value="Route 53: eks.feras-dev.co.uk" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#333333;container=1;collapsible=0;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="k8s-base"><mxGeometry x="20" y="300" width="220" height="50" as="geometry"/></mxCell><mxCell id="k8s-le" value="Let's Encrypt ACME" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#333333;container=1;collapsible=0;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="k8s-base"><mxGeometry x="20" y="380" width="220" height="50" as="geometry"/></mxCell><mxCell id="k8s-gh" value="GitHub main: gitops/ (kustomization.yaml, Applications, image-tags.yaml)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#333333;container=1;collapsible=0;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="k8s-base"><mxGeometry x="20" y="470" width="220" height="80" as="geometry"