 width="560" height="680" as="geometry"/></mxCell><mxCell id="cicd-dev" value="Developer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="cicd-ghbox"><mxGeometry x="40" y="40" width="30" height="56" as="geometry"/></mxCell><mxCell id="cicd-pr" value="Pull request → protected main&lt;br&gt;(ruleset: PR required, no force push)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=11;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#24292F;" vertex="1" parent="cicd-ghbox"><mxGeometry x="130" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="cicd-tf" value="terraform.yml: fmt, validate, tests, Checkov,&lt;br&gt;OIDC plan (environment dev-infrastructure)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=11;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#6A1B9A;" vertex="1" parent="cicd-ghbox"><mxGeometry x="20" y="150" width="520" height="56" as="geometry"/></mxCell><mxCell id="cicd-tfa" value="terraform-apply.yml: age-encrypted saved plan,&lt;br&gt;reviewer approval, apply (dev-infrastructure-apply)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=11;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#6A1B9A;" vertex="1" parent="cicd-ghbox"><mxGeometry x="20" y="230" width="520" height="56" as="geometry"/></mxCell><mxCell id="cicd-app" value="app.yml: ruff + pytest (PostgreSQL), Vitest, Checkov,&lt;br&gt;build api / etl / frontend, Trivy gate" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=11;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#2E7D32;" vertex="1" parent="cicd-ghbox"><mxG