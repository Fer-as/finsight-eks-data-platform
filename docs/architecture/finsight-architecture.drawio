<mxfile host="drawio" agent="FinSight G09 build script" version="24.0.0"><diagram id="overview" name="1. Overview: AWS network and flows"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1900" math="0" shadow="0"><root><mxCell id="overview-0"/><mxCell id="overview-base" value="Components and boundaries" parent="overview-0"/><mxCell id="overview-flow1" value="Flow 1  User request" parent="overview-0"/><mxCell id="overview-flow2" value="Flow 2  Outbound via NAT" parent="overview-0"/><mxCell id="overview-flow3" value="Flow 3  App CI/CD + GitOps" parent="overview-0"/><mxCell id="overview-flow4" value="Flow 4  Infrastructure CI (Terraform)" parent="overview-0"/><mxCell id="overview-flow5" value="Flow 5  Data / ETL (S3 planned)" parent="overview-0"/><mxCell id="overview-flow6" value="Flow 6  DNS + TLS automation" parent="overview-0"/><mxCell id="overview-flow7" value="Flow 7  Metrics scraping" parent="overview-0"/><mxCell id="overview-title" value="FinSight EKS data platform: AWS architecture (eu-west-2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="overview-base"><mxGeometry x="20" y="10" width="1420" height="40" as="geometry"/></mxCell><mxCell id="overview-origin" value="Native, editable draw.io diagram, originally constructed programmatically from the repository's Terraform and GitOps definitions; edit it in diagrams.net." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;fontStyle=2;align=right;fontColor=#555555;" vertex="1" parent="overview-base"><mxGeometry x="1450" y="14" width="770" height="34" as="geometry"/></mxCell><mxCell id="overview-status" value="&lt;b&gt;Deployment status (15 Oct 2026):&lt;/b&gt; the EKS cluster, managed node group and EKS add-ons were previously deployed with Terraform and reached ACTIVE, then destroyed for cost control; node Ready status was not demonstrated with kubectl. Images are published to ECR through the protected dev-images environment (first run 15 Oct, GitOps PR #46). NGINX, cert-manager, ExternalDNS, Argo CD, monitoring, the FinSight workloads and the in-cluster PostgreSQL with its database init Job are implemented in GitOps but &lt;b&gt;not yet deployed&lt;/b&gt;. &lt;i&gt;Planned&lt;/i&gt; (not implemented): the ETL reading S3 raw/ and writing curated/." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4CE;strokeColor=#C9A100;align=left;spacingLeft=10;fontSize=12;fontColor=#3D3000;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="overview-base"><mxGeometry x="20" y="56" width="2200" height="50" as="geometry"/></mxCell><mxCell id="overview-user" value="Internet users&lt;br&gt;(browser)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="overview-base"><mxGeometry x="105" y="150" width="30" height="56" as="geometry"/></mxCell><mxCell id="overview-ops" value="Operator workstation&lt;br&gt;kubectl / port-forward via the&lt;br&gt;EKS API endpoint (restricted CIDRs)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="overview-base"><mxGeometry x="105" y="300" width="30" height="56" as="geometry"/></mxCell><mxCell id="overview-ghbox" value="GitHub (external SaaS)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#333333;container=1;collapsible=0;fontFamily=Helvetica;fontStyle=1;fontSize=12;" vertex="1" parent="overview-base"><mxGeometry x="20" y="440" width="250" height="360" as="geometry"/></mxCell><mxCell id="overview-gh" value="Fer-as/finsight-eks-data-platform" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.github;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="overview-ghbox"><mxGeometry x="100" y="34" width="48" height="48" as="geometry"/></mxCell><mxCell id="overview-ghact" value="GitHub Actions&lt;br&gt;terraform.yml · terraform-apply.yml · app.yml" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#24292F;" vertex="1" parent="overview-ghbox"><mxGeometry x="14" y="120" width="222" height="50" as="geometry"/></mxCell><mxCell id="overview-ghenv" value="Protected environments:&lt;br&gt;dev-infrastructure (plan)&lt;br&gt;dev-infrastructure-apply (apply)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#24292F;" vertex="1" parent="overview-ghbox"><mxGeometry x="14" y="180" width="222" height="58" as="geometry"/></mxCell><mxCell id="overview-ghimg" value="dev-images publish (protected)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#24292F;" vertex="1" parent="overview-ghbox"><mxGeometry x="14" y="248" width="222" height="30" as="geometry"/></mxCell><mxCell id="overview-ghmain" value="main branch: gitops/ desired state&lt;br&gt;(image-tags.yaml via GitOps PR)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#1B1B1B;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#24292F;" vertex="1" parent="overview-ghbox"><mxGeometry x="14" y="288" width="222" height="50" as="geometry"/></mxCell><mxCell id=