{
  "uid": "finsight-overview",
  "title": "FinSight / Service overview",
  "description": "FinSight API request metrics, NGINX ingress traffic for the FinSight Services, and FinSight pod resources (G05).",
  "tags": ["finsight", "g05"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests per second by route and status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(finsight_api_requests_total{namespace=\"finsight\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 latency by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(finsight_api_request_duration_seconds_bucket{namespace=\"finsight\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API 5xx ratio",
      "description": "Share of API requests that returned a 5xx status. Shows 0 when no request failed; shows No data when the API is not being scraped (no requests recorded at all).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(finsight_api_requests_total{namespace=\"finsight\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(finsight_api_requests_total{namespace=\"finsight\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingress requests per second by status code (NGINX upstream responses)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(nginx_ingress_controller_upstream_server_response_latency_ms_count{resource_namespace=\"finsight\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingress p95 upstream latency by upstream (FinSight backend)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(nginx_ingress_controller_upstream_server_response_latency_ms_bucket{resource_namespace=\"finsight\"}[$__rate_interval])))",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingress requests per second by upstream (FinSight backend)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream) (rate(nginx_ingress_controller_upstream_server_response_latency_ms_count{resource_namespace=\"finsight\"}[$__rate_interval]))",
          "legendFormat": "{{upstream}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nginx_ingress_nginx_http_requests_total[$__rate_interval]))",
          "legendFormat": "all NGINX requests"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "FinSight pod CPU",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"finsight\", container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "FinSight pod memory (working set)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"finsight\", container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Scrape targets up (FinSight API and NGINX)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=~\"finsight|nginx-ingress\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    }
  ]
}
